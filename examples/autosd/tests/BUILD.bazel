load("@score_itf//:defs.bzl", "py_itf_test")

py_itf_test(
    name = "hello_qemu_test",
    srcs = [
        "conftest.py",
        "test_hello.py",
    ],
    args = [
        "--keep-target",  # needed because of bootc
        "--qemu-config=$(location @score_os_images//score/os/autosd:qemu_config)",
        "--qemu-rootfs=$(location @score_os_images//score/os/autosd:image)",
        "--bootc-oci-archive=$(location //:archive)",
    ],
    data = [
        "//:archive",
        "@score_os_images//score/os/autosd:image",
        "@score_os_images//score/os/autosd:qemu_config",
    ],
    plugins = ["@score_itf//score/itf/plugins:qemu_plugin"],
    tags = ["qemu-integration"],
    target_compatible_with = ["@platforms//os:linux"],
)
