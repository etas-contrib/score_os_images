load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@score_os_images//score/common/pkg_oci:defs.bzl", "pkg_oci")

# 1. Build a C program
cc_binary(
    name = "hello",
    srcs = ["hello.c"],
)

# 2. Add it to the prebuilt AutoSD bootc image as an extra layer
pkg_files(
    name = "hello_files",
    srcs = [":hello"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "usr/bin",
)

pkg_tar(
    name = "hello_layer",
    srcs = [":hello_files"],
    extension = "tar.gz",
)

oci_image(
    name = "image",
    base = "@score_os_images//score/os/autosd:image_bootc",
    tars = [":hello_layer"],
)

# 3. Pack the image into an oci-archive
pkg_oci(
    name = "archive",
    oci_image = ":image",
    visibility = ["//tests:__pkg__"],
)
