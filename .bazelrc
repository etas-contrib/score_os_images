build --java_language_version=17
build --tool_java_language_version=17
build --java_runtime_version=remotejdk_17
build --tool_java_runtime_version=remotejdk_17

test --test_output=errors
test --test_tag_filters=-qemu-integration

# Keep the QEMU images out of the default build; they need qemu/cloud-image-utils.
build --build_tag_filters=-qemu-integration

# Opt in to QEMU boot tests, which require KVM and the QEMU system emulators.
build:qemu-integration --build_tag_filters=qemu-integration
test:qemu-integration --test_tag_filters=qemu-integration
test:qemu-integration --run_under=@score_itf//scripts:run_under_qemu

common --registry=https://raw.githubusercontent.com/eclipse-score/bazel_registry/main/
common --registry=https://bcr.bazel.build
common --extra_toolchains=@score_linux_x86_64_ext4_toolchain//:ext4-x86_64-linux
