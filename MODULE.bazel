module(name = "score_os_images")

# Compliance and licensing toolchain
bazel_dep(name = "score_tooling", version = "3.0.2")
bazel_dep(name = "score_python_basics", version = "0.3.4")

# Formatting and linting helpers
bazel_dep(name = "score_format_checker", version = "0.1.1")

bazel_dep(
    name = "aspect_rules_lint",
    version = "2.9.1",
    dev_dependency = True,
)
bazel_dep(
    name = "buildifier_prebuilt",
    version = "10.1.0",
    dev_dependency = True,
)

# Rules used by the QEMU image definitions, also needed by consumers of the
# public targets (selects on @platforms, py_binary tools in score/common)
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# QEMU integration test framework
bazel_dep(name = "score_itf", version = "0.7.0", dev_dependency = True)
git_override(
    module_name = "score_itf",
    commit = "501c396a7ae5ab1fed0aceb20cb53a4360f16e0a",
    remote = "https://github.com/eclipse-score/itf.git",
)

bazel_dep(name = "rules_python", version = "1.9.0")

# Filesystem image rules, used to build the additional disk image attached to the
# QEMU targets via `--qemu-disk`.
bazel_dep(name = "score_rules_imagefs", version = "0.2.0", dev_dependency = True)

imagefs = use_extension("@score_rules_imagefs//extensions:imagefs.bzl", "imagefs", dev_dependency = True)
imagefs.toolchain(
    name = "score_linux_x86_64_ext4_toolchain",
    target_cpu = "x86_64",
    target_os = "linux",
    type = "ext4",
)
use_repo(imagefs, "score_linux_x86_64_ext4_toolchain")

python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.defaults(python_version = "3.12")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# oci tools
bazel_dep(name = "rules_oci", version = "2.3.1")
git_override(
    module_name = "rules_oci",
    commit = "f214185dcf149090cb3212e878f692eb2c8c0d3d",  # v2.3.1
    remote = "https://github.com/bazel-contrib/rules_oci.git",
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

###############################################################################
#
# EBcLfSA release archive used as base for the aarch64 QEMU image
#
###############################################################################
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "score_os_images_release_archive",
    downloaded_file_path = "score-image-trixie-ebclfsa-ebcl-qemuarm64.tar.gz",
    sha256 = "c0dcfbe2e22756fc9b9763e2c180306925e327c3b2b8442aa9196712e5767b72",
    urls = ["https://github.com/eclipse-score/os_images/releases/download/v0.0.5/score-image-trixie-ebclfsa-ebcl-qemuarm64.tar.gz"],
)

###############################################################################
#
# EB corbos Toolkit sources used to build the aarch64 image from scratch
#
# Only the KAS configuration, the bundled Isar layers and the development
# container setup are used, see //score/os/ebclfsa_aarch64.
#
###############################################################################
new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

new_git_repository(
    name = "eb_corbos_toolkit",
    build_file_content = """
exports_files(["BUILD.bazel"])

filegroup(
    name = "sources",
    srcs = glob(["kas/**", "layers/**", ".devcontainer/**"]),
    visibility = ["//visibility:public"],
)
""",
    commit = "fe2cddbc01232e4b62accb9abab783c8ccf75ef7",  # v2.0.0-beta3
    remote = "https://github.com/Elektrobit/eb_corbos_toolkit.git",
)

###############################################################################
#
# Ubuntu minimal cloud image used as base for the x86_64 QEMU image
#
# Pinned to a dated release directory so the download stays reproducible. The
# minimal image is used instead of the full server image to reduce test times.
# The file uses the ".img" extension but is in fact a qcow2 image.
#
###############################################################################
http_file(
    name = "ubuntu_noble_minimal_cloudimg_amd64",
    downloaded_file_path = "ubuntu-24.04-minimal-cloudimg-amd64.img",
    sha256 = "3839f148c5a3b4a736e7dbb0af75594743fa5ebee2a202424ba1a32e5d3b5d2c",
    urls = ["https://cloud-images.ubuntu.com/minimal/releases/noble/release-20261027/ubuntu-24.04-minimal-cloudimg-amd64.img"],
)

bazel_dep(
    name = "score_devcontainer",
    version = "1.14.0",
)

###############################################################################
#
# AutoSD Defintions
#
###############################################################################
bazel_dep(name = "score_os_autosd", version = "0.2.0")

http_file(
    name = "eclipse_autosd10_qemu_x86_64",
    downloaded_file_path = "eclipse-autosd-bootc-qemu-x86_64.qcow2.xz",
    sha256 = "ebf8c0316a573d3aaba6730043aeb800d4bf550aa06f5ce2dd8220277b933cfa",
    url = "https://download.eclipse.org/autosd/disk-images/eclipse-autosd-bootc-qemu-x86_64.qcow2.xz",
)

http_file(
    name = "eclipse_autosd10_qemu_aarch64",
    downloaded_file_path = "eclipse-autosd-bootc-qemu-aarch64.qcow2.xz",
    sha256 = "9becce2585d96906727c1d446e44250042b964836d1ae929ed8cb9ce916d3fbc",
    url = "https://download.eclipse.org/autosd/disk-images/eclipse-autosd-bootc-qemu-aarch64.qcow2.xz",
)

oci.pull(
    name = "eclipse_autosd10_qemu",
    digest = "sha256:91560c5c7e80b00347ad0ce8de0ec38c3682b989d3ca2bc63cb35976cb518c5c",
    image = "ghcr.io/eclipse-autosd/eclipse-autosd-bootc-qemu",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
    tag = "latest",
)
use_repo(
    oci,
    "eclipse_autosd10_qemu",
    "eclipse_autosd10_qemu_linux_amd64",
    "eclipse_autosd10_qemu_linux_arm64",
)

autosd_rpm = use_repo_rule("@score_os_autosd//rules/autosd_dep:defs.bzl", "autosd_rpm")

autosd_rpm(
    name = "autosd_itf_rpms_x86_64",
    arch = "x86_64",
    build = "//score/os/autosd/pkg:itf.BUILD.bazel",
    packages = [
        "iproute",
        "iputils",
    ],
    visibility = ["//visibility:public"],
)

autosd_rpm(
    name = "autosd_itf_rpms_aarch64",
    arch = "aarch64",
    build = "//score/os/autosd/pkg:itf.BUILD.bazel",
    packages = [
        "iproute",
        "iputils",
    ],
    visibility = ["//visibility:public"],
)
