module(
    name = "os_images",
    version = "1.0",
)

# ------------------------------------------------------------------------------
# QNX toolchains

bazel_dep(name = "score_rules_imagefs", version = "0.0.1")
git_override(
    module_name = "score_rules_imagefs",
    remote = "https://github.com/eclipse-score/rules_imagefs.git",
    commit = "38d5a1a5e5d83faa5d00e4d2f31c303db0d0f7de",
)

imagefs = use_extension("@score_rules_imagefs//extensions:imagefs.bzl", "imagefs", dev_dependency = True)
imagefs.sdp(
    name = "score_qnx_imagefs_toolchain_pkg",
    url = "https://www.qnx.com/download/download/87174/installation_qnx_803_260305.tar.xz",
    sha256 = "9039fd6a4a639f06ea977afb93963a6fe8f8c46db727066709370d999c7232e0",
    build_file = "//:sdp.BUILD",
)

imagefs.toolchain(
    name = "score_qnx_ifs_toolchain",
    sdp_to_import = "@score_qnx_imagefs_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "aarch64",
    target_os = "qnx",
    type = "ifs",
    )
imagefs.toolchain(
    name = "score_qnx_fatfs_toolchain",
    sdp_to_import = "@score_qnx_imagefs_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "aarch64",
    target_os = "qnx",
    type = "fatfs",
    )
imagefs.toolchain(
    name = "score_qnx_qnx6fs_toolchain",
    sdp_to_import = "@score_qnx_imagefs_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "aarch64",
    target_os = "qnx",
    type = "qnx6fs",
    )
imagefs.toolchain(
    name = "score_qnx_diskimage_toolchain",
    sdp_to_import = "@score_qnx_imagefs_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "aarch64",
    target_os = "qnx",
    type = "diskimage",
    )

use_repo(
    imagefs,
    "score_qnx_imagefs_toolchain_pkg",
    "score_qnx_ifs_toolchain",
    "score_qnx_fatfs_toolchain",
    "score_qnx_qnx6fs_toolchain",
    "score_qnx_diskimage_toolchain",
)

register_toolchains(
    "@score_qnx_ifs_toolchain//:ifs-aarch64-qnx-sdp_8.0.0",
    "@score_qnx_fatfs_toolchain//:fatfs-aarch64-qnx-sdp_8.0.0",
    "@score_qnx_qnx6fs_toolchain//:qnx6fs-aarch64-qnx-sdp_8.0.0",
    "@score_qnx_diskimage_toolchain//:diskimage-aarch64-qnx-sdp_8.0.0",
)


# ------------------------------------------------------------------------------
# External BSP archives
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Replace the closed-source BSP ZIP with the open-source GitHub repo
http_archive(
    name = "qnx8_bsp_rpi4_src",
    url = "https://github.com/qnx/bsp_raspberrypi-bcm2711-rpi4/archive/refs/heads/main.tar.gz",
    strip_prefix = "bsp_raspberrypi-bcm2711-rpi4-main",
    # sha256 = "<compute after first download>",
    build_file_content = """
# Expose the Makefile as a single-file target for $(location) in genrule
exports_files(["Makefile"])

# Expose all BSP sources so the genrule can access them
filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
)

# ------------------------------------------------------------------------------
# External RPI4 firmware archive
http_archive(
    name = "rpi4_firmware_files",
    url = "https://github.com/raspberrypi/firmware/releases/download/1.20250915/raspi-firmware_1.20250915.orig.tar.xz",
    strip_prefix = "raspi-firmware-1.20250915/boot",
    sha256 = "545b5f8a624b98222c7b4ef4244ac219845993aba15e49d5440b21ccd722340e",
    build_file_content = """
exports_files(["fixup4.dat"])

filegroup(
    name = "rpi4_files",
    srcs = [
        "start4.elf",
        "start4x.elf",
        "start4db.elf", 
        "start4cd.elf",
        "fixup4.dat",
        "fixup4x.dat",
        "fixup4db.dat",
        "fixup4cd.dat",
    ],
    visibility = ["//visibility:public"],
)
""",
)
# External RPI4 dtb file
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "rpi4_dtb",
    url = "https://github.com/raspberrypi/firmware/raw/refs/heads/stable/boot/bcm2711-rpi-4-b.dtb",
    downloaded_file_path = "bcm2711-rpi-4-b.dtb",
    # sha256 = "<compute after first download>",
)

