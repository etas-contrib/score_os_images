load("@rules_python//python:defs.bzl", "py_test")
load("@score_itf//:defs.bzl", "py_itf_test")

test_suite(
    name = "qemu_tests",
    tags = ["manual"],
    tests = [
        ":autosd_qemu_tests",
    ],
)

py_itf_test(
    name = "autosd_qemu_tests",
    srcs = [
        "conftest.py",
        "test_base_distro.py",
        "test_bootc.py",
        "//score/tests:test_multicast.py",
        "//score/tests:test_ping.py",
    ],
    args = [
        "--keep-target",  # needed because of bootc
        "--qemu-config=$(location //score/os/autosd/itf:qemu_config_x86_64.json)",
        "--qemu-rootfs=$(location //score/os/autosd/image:qemu_disk)",
        "--bootc-oci-archive=$(location //score/os/autosd/image:itf_bootc_archive)",
    ],
    data = [
        "//score/os/autosd/image:itf_bootc_archive",
        "//score/os/autosd/image:qemu_disk",
        "//score/os/autosd/itf:qemu_config_x86_64.json",
    ],
    plugins = ["@score_itf//score/itf/plugins:qemu_plugin"],
    tags = ["qemu-integration"],
    target_compatible_with = ["@platforms//os:linux"],
)
