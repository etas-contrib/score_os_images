package(default_visibility = ["//visibility:public"])

alias(
    name = "image",
    actual = "//score/os/autosd/image:qemu_disk",
)

alias(
    name = "image_bootc",
    actual = "//score/os/autosd/image:bootc_qemu",
)

alias(
    name = "qemu_config",
    actual = select({
        "@platforms//cpu:x86_64": "//score/os/autosd/itf:qemu_config_x86_64",
        "@platforms//cpu:aarch64": "//score/os/autosd/itf:qemu_config_aarch64.json",
    }),
)
