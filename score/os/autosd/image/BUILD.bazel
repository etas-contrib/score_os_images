load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "pkg_mklink")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//score/common/img_archive:defs.bzl", "img_archive")
load("//score/common/pkg_oci:defs.bzl", "pkg_oci")

package(default_visibility = ["//visibility:public"])

pkg_files(
    name = "multicast_script",
    srcs = ["files/enable-multicast.sh"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "usr/libexec",
)

pkg_files(
    name = "multicast_service",
    srcs = ["files/multicast-route.service"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "usr/lib/systemd/system",
)

# Equivalent of `systemctl enable`, following WantedBy=multi-user.target
pkg_mklink(
    name = "multicast_service_enable",
    link_name = "usr/lib/systemd/system/multi-user.target.wants/multicast-route.service",
    target = "../multicast-route.service",
)

pkg_tar(
    name = "itf_bootc_layer",
    srcs = [
        ":multicast_script",
        ":multicast_service",
        ":multicast_service_enable",
        "//score/os/autosd/pkg:itf_bootc_layer",
    ],
    extension = "tar.gz",
)

alias(
    name = "bootc_qemu",
    actual = select({
        "@platforms//cpu:x86_64": ":bootc_qemu_amd64",
        "@platforms//cpu:aarch64": ":bootc_qemu_arm64",
    }),
)

oci_image(
    name = "bootc_qemu_amd64",
    base = "@eclipse_autosd10_qemu_linux_amd64",
    tars = [
        ":itf_bootc_layer",
    ],
)

oci_image(
    name = "bootc_qemu_arm64",
    base = "@eclipse_autosd10_qemu_linux_arm64",
    tars = [
        ":itf_bootc_layer",
    ],
)

pkg_oci(
    name = "itf_bootc_archive",
    oci_image = ":bootc_qemu",
)

img_archive(
    name = "qemu_disk_x86_64",
    src = "@eclipse_autosd10_qemu_x86_64//file",
    visibility = ["//visibility:public"],
)

img_archive(
    name = "qemu_disk_aarch64",
    src = "@eclipse_autosd10_qemu_aarch64//file",
    visibility = ["//visibility:public"],
)

alias(
    name = "qemu_disk",
    actual = select({
        "@platforms//cpu:x86_64": ":qemu_disk_x86_64",
        "@platforms//cpu:aarch64": ":qemu_disk_aarch64",
    }),
)
