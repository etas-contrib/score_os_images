package(default_visibility = ["//visibility:public"])

exports_files(["itf.BUILD.bazel"])

alias(
    name = "itf_bootc_layer_x86_64",
    actual = "@autosd_itf_rpms_x86_64//:itf_booc_layer",
    visibility = ["//visibility:public"],
)

alias(
    name = "itf_bootc_layer_aarch64",
    actual = "@autosd_itf_rpms_aarch64//:itf_booc_layer",
    visibility = ["//visibility:public"],
)

alias(
    name = "itf_bootc_layer",
    actual = select({
        "@platforms//cpu:x86_64": ":itf_bootc_layer_x86_64",
        "@platforms//cpu:aarch64": ":itf_bootc_layer_aarch64",
    }),
    visibility = ["//visibility:public"],
)
