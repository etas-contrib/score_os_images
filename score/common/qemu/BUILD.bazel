load(":qemu_config.bzl", "uefi_path")

package(default_visibility = ["//visibility:public"])

exports_files(["qemu_config.bzl"])

# Host paths to the UEFI firmware substituted into QEMU config templates.
# No default; set them on the command line, e.g. on Ubuntu 24.04 (ovmf package)
# --//score/common/qemu:uefi_code=/usr/share/OVMF/OVMF_CODE_4M.fd
# --//score/common/qemu:uefi_vars=/usr/share/OVMF/OVMF_VARS_4M.fd
uefi_path(
    name = "uefi_code",
    build_setting_default = "",
)

uefi_path(
    name = "uefi_vars",
    build_setting_default = "",
)
