#
# Prebuilt U-Boot binaries, one target per board. Pass them as `binary` to
# uboot_boot_files (//score/boot/uboot:uboot.bzl).
#
# The BUILD file applied to the extracted u-boot-rpi .deb lives in uboot.BUILD
# and is referenced from MODULE.bazel via the `deb` rule's `build` attribute.

exports_files(["uboot.BUILD"])

# 64-bit Raspberry Pi U-Boot (rpi_arm64, boots Pi 3/4/400/CM4) from the Ubuntu
# u-boot-rpi package.
alias(
    name = "rpi_arm64",
    actual = "@u_boot_rpi_deb//:rpi_arm64",
    visibility = ["//visibility:public"],
)
